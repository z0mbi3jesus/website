# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Public Turnstile site key: set turnstileSiteKey in contact.html.
# Static HTML does not automatically read this .env file.
TURNSTILE_SITE_KEY=

# Supabase Edge Function
SUPABASE_FUNCTION_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Configure these in Supabase Dashboard > Edge Functions > Secrets for production.
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=6thlevel.net,www.6thlevel.net

# Resend email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=hutton@6thlevel.net
CONTACT_TO_EMAIL=hutton@6thlevel.net
